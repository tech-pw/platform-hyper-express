{
  "name": "@pw-tech/platform-hyper-express",
  "version": "1.0.0",
  "tag": "latest",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b .",
    "compile": "tsc --build ./tsconfig.build.json",
    "start:local": "node --watch-path=./src dist/test.js & tsc -w",
    "start:dev": "npm run build && node dist/index.js",
    "distribute": "npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js -t=hello-world",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:integrations": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./tests/jest-config.json",
    "test:integrations:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./tests/jest-config.json --watchAll",
    "lint": "eslint src tests"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "body-parser": "2.4.0",
    "content-type": "3.1.1",
    "cors": "2.8.6",
    "hyper-express": "^7.0.2",
    "live-directory": "3.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/testing": "^12.6.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.9",
    "class-validator": "^0.15.1",
    "eslint": "^10.15.0",
    "eventsource": "^5.1.5",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "pactum": "^3.9.1",
    "prettier": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "tests",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
